---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Buttons from "../components/Buttons.astro"
import Cards from "../components/Cards.astro"

const supabaseUrl = "https://lowqopppgtqzcjjeezeu.supabase.co"
const supabaseKey = "sb_publishable_nym7Jt8c5eKgQ8fySuMaCQ_LS9iXeuU"

type Plan = {
  id: number;
  title: string;
  price: number;
  info: string;
};

let plans: Plan[] = [];

try {
  const res = await fetch(
    `${supabaseUrl}/rest/v1/plan?select=id,title,price,info`,
    {
      headers: {
        apikey: supabaseKey,
        Authorization: `Bearer ${supabaseKey}`,
      },
    }
  );

  if (!res.ok) {
    console.error("Supabase index error", res.status, await res.text());
  } else {
    plans = await res.json();
  }
} catch (err) {
  console.error("Supabase index fetch failed", err);
}

function formatPrice(price: number | null | undefined) {
  if (price == null) return "";
  return new Intl.NumberFormat("da-DK").format(price);
}

---

<BaseLayout>
<Nav />

<section class="hero">
  <img class="hero-image" src="/relax.webp" alt="Woman Relaxing">
</section>

<section class="product">
<div class="grid_1-1">
 <div class="info">
    <h1>From<br><span class="bold">DKK 9,999</span><br>Up to 100 employees</h1>
    <p>Full acces to SoundWheel work</p>
    <Buttons label="BUY ACCESS" href="/product" variant="dark" />
 </div>
 <div>
    <img src="phones.webp" alt="Two Phones">
 </div>

</div>
</section>

<section class="plans">
<h2>Select a plan</h2>

<div class="grid_1-1-1">
    {plans?.map((plan: Plan) => (
    <Cards
      h1={plan.title}
      h2={plan.info}
      h3={`DKK ${formatPrice(plan.price)}`}
      href={`/product/${plan.id}`}   
    />
  ))}
</div>
</section>

<section class="information">
<div class="info_tekst">
<p>In a busy workday, small mental breaks are essential for employee wellbeing, focus, and productivity.<br>
SoundWheel’s sound-based journeys offer an easy and engaging way to pause, reducing stress while helping employees reset mentally. By combining dynamic music, SoundWheel supports a healthier pause culture and provides a quick, effective boost of clarity and renewed energy.</p>
</div>

    <img src="logo-svg.svg" alt="logo" class="img-left">
    <img src="wave.webp" alt="wave icon" class="img-right">
</section>

<section class="workshop">
<h3>Our Workshops</h3>
<h2>Book a live SoundWheel workshop to boost<br>team wellbeing with guided sound, mindful<br>pause, and mental clarity.</h2>

<div class="workshop_grid">
 <div class="workshop_card">
  <div class="workshop_images-row">
    <img src="tre.webp" alt="Three People" class="workshop_img">
    <img src="sound.webp" alt="Two people listening" class="workshop_img">
  </div>

  <div class="workshop_info-row">
    <p class="workshop_text">
      For those feeling the pressure of busy days<br>
      this session offers a moment to breathe.
    </p>
    <span class="badge">55 Min</span>
  </div>
</div>

  <div class="workshop_card workshop_right">
  <img src="yoga.webp" alt="People relaxing" class="workshop_img">

  <div class="workshop_info-row">
    <p class="workshop_text">
      Each session leads employees through<br>immersive sound and visualization designed 
      to<br>ease stress and renew mental energy.
    </p>

    <div class="workshop_buttons">
      <Buttons label="BOOK NOW" href="/product" variant="dark" />
      <button class="arrow_btn">→</button>
    </div>
  </div>
</div>
</div>
</section>

<section class="Hall">
<h2> Hall of<br>Happy Employees</h2>

<div class="hall-gallery">
  <figure class="hall-item"><img src="hall1.webp" alt="Employee 1"></figure>
  <figure class="hall-item"><img src="hall2.webp" alt="Employee 2"></figure>
  <figure class="hall-item"><img src="hall3.webp" alt="Employee 3"></figure>
  <figure class="hall-item"><img src="hall4.webp" alt="Employee 4"></figure>
  <figure class="hall-item hide-mobile"><img src="hall5.webp" alt="Employee 5"></figure>
  <figure class="hall-item hide-mobile"><img src="hall6.webp" alt="Employee 6"></figure>
</div>
</section>


<Footer />
</BaseLayout>

<style>
