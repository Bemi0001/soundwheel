}

.product{
    margin-top: 9rem;
    margin-bottom: 6rem;
}

h1{
 line-height: 2.5rem;
 font-weight: 300;
 font-size: 1.8rem;
 margin-bottom: 50px;
}

.bold {
    font-weight: 800;
    font-size: 2.7rem;
}

p{
    font-size: 1.8rem;
