}

h2{
    font-size: 3.5rem;
    text-align: center;
    margin-bottom: 20px;
}

.information{
    background-color: #3C1415;
    border-radius: 16px;
    padding-inline: 1rem;
    padding-top: 3rem;
    padding-bottom: 20rem;
    margin-bottom: 60px;
