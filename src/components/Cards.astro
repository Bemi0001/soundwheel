---
import Buttons from "../components/Buttons.astro"

export interface Props {
  h1: string;
  h2: string;
  h3: string;
  href?: string;
}

const { h1, h2, h3, href = "/product" } = Astro.props;

---


<style>
  .card {
    width: 300px;
    height: 300px;
    background: #3C1415;
    border-radius: 16px;
    padding: 1rem;
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between; 
     align-items: center; 
    text-align: center;
    
  }

  .text-group {
    flex-direction: column;
    color: #EEEAEA;
    margin-top: 15px;
    gap: 0.1rem;  
  }
  h1 {
    font-size: 22px;
    font-weight: lighter;
    font-family: "Heebo", sans-serif;
  }

  h2 {
    font-size: 22px;
    font-weight: bold;
    font-family: "Heebo", sans-serif;
  }

h3 {
    font-size: 22px;
    font-weight: lighter;
     font-family: "Heebo", sans-serif;
}

button {
  margin-top: 6rem; 
}

@media (max-width: 750px) {
  .card {
    width: 100%;      
    height: auto;
    padding: 6rem 6rem;
  }

  .text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;        
    margin-top:;
    margin-bottom: 50px;
  }

  .card h1,
  .card h2,
  .card h3 {
    font-size: 1.4rem;      /
    line-height: 1.2;
    margin: 0;              
    white-space: nowrap;   
  }


}


</style>

<div class="card">
  <div class="text-group">
    <h1>{h1}</h1>
    <h2>{h2}</h2>
    <h3>{h3}</h3>
  </div>

  <Buttons label="BUY ACCESS" href={href} variant="light" /> 
</div>

