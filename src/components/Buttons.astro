---
const {label = "Click", href = "#", variant = "light",} = Astro.props;
---

<a href={href} class={`btn ${variant}`}>
  {label}
</a>

<style>
  .btn {
    padding: 0.9rem 2.5rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 200;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  
  .light {
    background-color: #ece8e8;
    color: #3c1415;
  }

  
  .dark {
    background-color: #3c1415;
    color: #ece8e8;
  }

  .btn:hover {
    opacity: 0.9;
  }
</style>
