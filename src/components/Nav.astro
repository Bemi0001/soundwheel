  </ul>
</div>

<style>



/* ------------------- */
/* MOBILE (<750px) */
.mobile-navbar {
  display:flex;
  justify-content: space-between; /* logo venstre, burger højre */
  align-items:center;
  padding:12px 0px;
  background:white;
  position:relative;
  z-index:1000;
}

/* Logo til venstre */
.mobile-navbar .logo {
  flex-shrink: 0;
  margin-right: auto; 
 
}

.mobile-navbar .logo img {
  height:120px; /* mindre logo til mobil */
  margin-right: auto;
  display: block;


}


/* Burger større og matchet med logo */
.burger {
  width:24px;
  height:18px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  background:none;
  border:none;
  cursor:pointer;
  padding:0;
  margin-right: 28px;
  
}

.burger span {
  display:block;
  height:3px;  /* lidt tykkere */
  background:black;
  border-radius:2px;
  transition: all 0.3s ease;
}

.burger.open span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); }
.burger.open span:nth-child(2) { opacity:0; }
.burger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); }

/* Fullscreen menu */
.mobile-menu {
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background:#3C1415; /* brun baggrund kun til mobil */
  color:white;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  align-items:flex-start;
  padding:40px 40px 60px 40px;
  transform:translateY(-100%);
  transition:transform 0.5s ease;
  overflow-y:auto;
  z-index:9999;
}

.mobile-menu.open { transform:translateY(0); }

.closeBtn {
  position:absolute;
  top:20px;
  right:20px;
  font-size:48px;
  color:white;
  background:none;
  border:none;
  cursor:pointer;
}

.mobile-menu li {
  opacity:0;
  transform:translateY(20px);
  transition: opacity 0.5s ease, transform 0.5s ease;
  list-style:none;
}

.mobile-menu li.show {
  opacity:1;
  transform:translateY(0);
}

.mobile-menu li a {
  color:white;
  text-decoration:none;
  font-size:48px;
  font-weight:bold;
  display:block;
  margin-bottom:30px;
}

/* ------------------- */
/* DESKTOP (≥750px) */
.desktop-navbar {
  display:none;
  width:100%;
  background:white; /* hvid baggrund til desktop */
  justify-content:space-between;
  align-items:center;
  padding:20px 40px;
  box-sizing:border-box;
}

.desktop-navbar ul {
  list-style:none;
  display:flex;
  gap:40px;
  margin:0;
  padding:0;
}

.desktop-navbar li a {
  text-decoration:none;
  color:black; /* sort tekst til desktop */
  font-size:24px;
  font-weight:light;
}

.desktop-navbar .logo {
  order:0; /* logo midt mellem left og right */
}

.desktop-navbar .logo img { height:150px; }

/* MEDIA QUERY */
@media (min-width: 750px) {
  .mobile-navbar { display:none; }
  .desktop-navbar { display:flex; }
}
</style>

<script is:inline>
const burger = document.getElementById("burgerBtn");
const mobileMenu = document.getElementById("mobileMenu");
const closeBtn = document.getElementById("closeMenu");
const links = mobileMenu.querySelectorAll("li");
let timeouts = [];

// Åben menu
burger.addEventListener("click", () => {
  burger.classList.add("open");
  mobileMenu.classList.add("open");

  timeouts.forEach(t => clearTimeout(t));
  timeouts = [];

  links.forEach((link, i) => {
    const t = setTimeout(() => link.classList.add("show"), i*100);
    timeouts.push(t);
  });
});

// Luk menu
closeBtn.addEventListener("click", () => {
  burger.classList.remove("open");
  mobileMenu.classList.remove("open");

  links.forEach(link => link.classList.remove("show"));
  timeouts.forEach(t => clearTimeout(t));
  timeouts = [];
});
</script>
